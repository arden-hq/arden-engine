{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "arden-engine",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": {
    "packages": [
      "libs/*",
      "apps/cli",
      "apps/server-ts",
      "apps/relay"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.0-beta.107",
      "@effect/sql-sqlite-node": "4.0.0-beta.107",
      "@types/node": "24.10.1",
      "effect": "4.0.0-beta.107",
      "typescript": "7.0.2",
      "vitest": "4.1.12"
    }
  },
  "scripts": {
    "postinstall": "node tooling/prepare-node-pty.cjs",
    "build:libs": "bun run --filter './libs/*' build",
    "typecheck:libs": "bun run --filter './libs/*' typecheck",
    "build:server": "bun run --filter '@arden-hq/server' build",
    "typecheck:server": "bun run --filter '@arden-hq/server' typecheck",
    "build:cli": "bun run --filter '@arden-hq/cli' build",
    "typecheck:cli": "bun run --filter '@arden-hq/cli' typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "node tooling/lint.mjs",
    "check:tells": "bun --conditions=arden-source tooling/told-tables.mjs",
    "check:decision-words": "node tooling/decision-words.mjs",
    "test:libs": "bun run --sequential --filter './libs/*' test",
    "test:server": "bun run --filter '@arden-hq/server' test",
    "test:cli": "bun run --filter '@arden-hq/cli' test",
    "knip": "knip --no-progress --no-config-hints",
    "depcruise": "NODE_OPTIONS=--import=./tooling/depcruise-typescript.mjs depcruise --ignore-known --output-type err libs apps/cli/src apps/cli/test apps/server-ts/src apps/server-ts/test apps/relay/src apps/relay/test",
    "check:migrations": "bun run --cwd apps/server-ts check:migrations",
    "test:dist": "bun run --filter './libs/*' test:dist"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.4.0",
    "effect": "catalog:",
    "knip": "6.38.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.107",
    "body-parser": "^2.4.0",
    "effect": "4.0.0-beta.107",
    "fast-uri": "^3.1.9",
    "form-data": "^4.0.6",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.19",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.107": "patches/effect@4.0.0-beta.107.patch"
  }
}
