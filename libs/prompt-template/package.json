{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arden-hq/prompt-template",
  "version": "0.1.7",
  "description": "A strict, platform-neutral prompt template renderer",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "arden-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../tooling/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/libs-prompt-template.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arden-hq/arden-engine.git",
    "directory": "libs/prompt-template"
  }
}
