{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arden-hq/sqlite-thread",
  "version": "0.1.1",
  "description": "An Effect SQL client whose SQLite connection runs on a worker thread",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "arden-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "LICENSE",
    "README.md",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../tooling/clean-dist.mjs",
    "prepack": "bun run clean && bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/libs-sqlite-thread.tsbuildinfo"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arden-hq/arden-engine.git",
    "directory": "libs/sqlite-thread"
  }
}
