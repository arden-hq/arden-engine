{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arden-hq/loop",
  "version": "0.1.5",
  "description": "Provider-independent Promise and AsyncIterable runtime for tool-calling agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "arden-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/openai-responses": {
      "arden-source": "./src/providers/openai-responses/provider.ts",
      "types": "./dist/providers/openai-responses/provider.d.ts",
      "import": "./dist/providers/openai-responses/provider.js"
    },
    "./provider-kit": {
      "arden-source": "./src/providers/kit/index.ts",
      "types": "./dist/providers/kit/index.d.ts",
      "import": "./dist/providers/kit/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "agent",
    "tool-calling",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../tooling/clean-dist.mjs",
    "prepack": "bun run clean && bun run build",
    "typecheck": "tsc -p tsconfig.check.json --noEmit --pretty false --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/libs-loop.tsbuildinfo",
    "test": "vitest run --exclude test/public-boundary.test.ts",
    "test:dist": "bun run build && vitest run test/public-boundary.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@arden-hq/std": "workspace:*",
    "eventsource-parser": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arden-hq/arden-engine.git",
    "directory": "libs/loop"
  }
}
