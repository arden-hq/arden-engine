{
  "name": "openrouter-replace-model-before-running",
  "provider": "chat-completions",
  "server": "openrouter",
  "baseUrl": "https://openrouter.ai/api/v1",
  "apiKeyEnv": "OPENROUTER_API_KEY",
  "model": "REPLACE_WITH_MODEL_ID",
  "reasoningEffort": null,
  "contextLimit": 128000,
  "timeoutMs": 600000,
  "maxModelRequests": 100,
  "tools": [
    "spawn_agent",
    "exec_command",
    "write_stdin",
    "file_read",
    "file_list",
    "file_find",
    "file_search_text",
    "file_write",
    "file_edit"
  ],
  "memory": false
}
