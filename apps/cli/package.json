{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arden-hq/cli",
  "version": "0.1.2",
  "private": true,
  "description": "Command-line client for an Arden server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "arden": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../tooling/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit --pretty false --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/apps-cli.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@arden-hq/headless": "workspace:*",
    "@arden-hq/protocol": "workspace:*",
    "@arden-hq/std": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
