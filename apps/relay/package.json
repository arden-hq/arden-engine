{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arden-hq/relay",
  "version": "0.1.1",
  "private": true,
  "description": "The Arden relay: routes sealed frames between a Mac and its phones (Bun and Cloudflare adapters)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "bun --conditions=arden-source src/bun/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/apps-relay.tsbuildinfo",
    "test": "bun test --conditions=arden-source"
  },
  "dependencies": {
    "@arden-hq/relay-protocol": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "1.3.10",
    "typescript": "catalog:"
  }
}
